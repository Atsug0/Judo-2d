# Godot
.godot/
*.import
export_presets.cfg
/build/
# Captures et fichiers temporaires
/captures/
*.tmp
# Rushes vidéo et images intermédiaires (lourds, régénérables)
/rushes/
/animations/_frames/
# Sprites placeholder cuits (régénérables : godot --path . -- --screen=bake --capture=/tmp/x)
/animations/placeholder_*/
__pycache__/
# Textures extraites par l import Godot des modèles 3D (.png en 4.4, .jpg en 4.7)
assets/judokas/*/rig_*.png
assets/judokas/*/rig_*.jpg
# Modèles bruts déposés depuis Tripo (lourds, non versionnés tant que git-lfs n'est pas
# installé : les modèles utiles sont importés dans assets/judokas/ par tools/rig/import_tripo.py)
/new asset/
.DS_Store
